# Public application URL used for metadata, OpenGraph images, sitemap, and canonical URLs
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Enables demo store banners, payment simulation controls, and mock states
NEXT_PUBLIC_DEMO_MODE="true"

# Indexing safety control: keep "false" for POC so robots.txt and meta headers disallow search engines
ALLOW_INDEXING="false"

